namespace LOSTARK_GEM_FINDER.Core
{
    public static class AppConstants
    {
        public const string APP_NAME = "보석 최저가 검색기";

        // 🌟 exe 폴더가 아닌 사용자 AppData에 저장 → 새 버전을 다른 폴더에 풀어도 데이터가 그대로 유지됨
        public static readonly string DataDirectory = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), APP_NAME);
        public static readonly string DataFilePath = Path.Combine(DataDirectory, "GemData.json");
        public static readonly string KeyFilePath = Path.Combine(DataDirectory, "ApiKey.dat");

        public const string API_BASE_URL = "https://developer-lostark.game.onstove.com";
        public const string API_KEY_PAGE_URL = "https://developer-lostark.game.onstove.com/";

        // 경매장 검색 조건
        public const int GEM_CATEGORY_CODE = 210000;
        public const int MIN_GEM_LEVEL = 7;
        public const int MAX_GEM_LEVEL = 10;
        public const string GEM_NAME_FORMAT = "{0}레벨 {1}";   // 예: 10레벨 겁화의 보석

        // 🌟 보석 종류는 여기만 고치면 표·알림·그래프에 모두 반영됨
        private const int TIER_4 = 4;
        public static readonly GemType[] GemTypes =
        {
            new GemType("겁화", "겁화의 보석", TIER_4),
            new GemType("작열", "작열의 보석", TIER_4)
        };

        // 통신
        public const int API_TIMEOUT_SECONDS = 15;
        public const int MAX_CONCURRENT_REQUESTS = 3;   // 동시에 보내는 요청 수 (호출 한도 보호)
        public const int MAX_SEARCH_PAGES = 3;          // 정확한 이름의 매물을 찾을 때까지 넘겨볼 최대 페이지

        // 자동 갱신 / 알림
        public const int MS_PER_MINUTE = 60 * 1000;
        public const int AUTO_REFRESH_MINUTES = 1;
        public const int AUTO_REFRESH_INTERVAL_MS = AUTO_REFRESH_MINUTES * MS_PER_MINUTE;
        public const int BALLOON_TIP_MS = 3000;

        public const string HISTORY_DATE_FORMAT = "yyyy-MM-dd";
    }
}﻿using System;
using System.Linq;
using System.Net;
using System.Net.Http;
using System.Text;
using System.Threading.Tasks;
using Newtonsoft.Json.Linq;
using LOSTARK_GEM_FINDER.Core;

namespace LOSTARK_GEM_FINDER.Services
{
    public class AuctionAPI : IAuctionAPI
    {
        private const string AUCTION_SEARCH_PATH = "auctions/items";
        private const string SORT_BY_BUY_PRICE = "BUY_PRICE";
        private const string SORT_ASCENDING = "ASC";
        private const int FIRST_PAGE = 1;
        private const int HTTP_TOO_MANY_REQUESTS = 429;

        private readonly HttpClient _client;

        public AuctionAPI(string apiKey)
        {
            _client = new HttpClient
            {
                BaseAddress = new Uri(AppConstants.API_BASE_URL + "/"),
                Timeout = TimeSpan.FromSeconds(AppConstants.API_TIMEOUT_SECONDS)
            };
            SetApiKey(apiKey);
        }

        // 요청이 진행 중이지 않을 때만 호출됨 (MainForm에서 보장)
        public void SetApiKey(string apiKey)
        {
            _client.DefaultRequestHeaders.Clear();
            _client.DefaultRequestHeaders.Add("accept", "application/json");
            _client.DefaultRequestHeaders.Add("authorization", "Bearer " + apiKey);
        }

        public async Task<long?> GetLowestBuyPriceAsync(string itemName, int itemTier)
        {
            int lastPage = FIRST_PAGE + AppConstants.MAX_SEARCH_PAGES - 1;

            for (int page = FIRST_PAGE; page <= lastPage; page++)
            {
                JObject json = await SearchAsync(itemName, itemTier, page);
                var items = json["Items"] as JArray;
                if (items == null || items.Count == 0) return null;

                // 🌟 "1레벨 겁화의 보석" 검색에 "10레벨"도 섞여 나오므로 이름이 정확히 같은 매물만 사용
                //    즉시 구매가가 없는 입찰 전용 매물도 제외
                long? lowest = items
                    .Where(i => (string)i["Name"] == itemName)
                    .Select(i => i["AuctionInfo"]?["BuyPrice"]?.Value<long?>())
                    .Where(p => p.HasValue && p.Value > 0)
                    .Min();

                if (lowest.HasValue) return lowest;

                int pageSize = json["PageSize"]?.Value<int?>() ?? 0;
                if (pageSize > 0 && items.Count < pageSize) return null;   // 마지막 페이지
            }
            return null;
        }

        private async Task<JObject> SearchAsync(string itemName, int itemTier, int page)
        {
            var payload = new JObject
            {
                { "CategoryCode", AppConstants.GEM_CATEGORY_CODE },
                { "ItemTier", itemTier },
                { "ItemName", itemName },
                { "Sort", SORT_BY_BUY_PRICE },
                { "SortCondition", SORT_ASCENDING },
                { "PageNo", page }
            };

            using (var content = new StringContent(payload.ToString(), Encoding.UTF8, "application/json"))
            using (var res = await SendAsync(() => _client.PostAsync(AUCTION_SEARCH_PATH, content)))
            {
                EnsureSuccess(res);
                return JObject.Parse(await res.Content.ReadAsStringAsync());
            }
        }

        private static async Task<HttpResponseMessage> SendAsync(Func<Task<HttpResponseMessage>> request)
        {
            try
            {
                return await request();
            }
            catch (TaskCanceledException)
            {
                throw new TimeoutException("API 응답 시간이 초과되었습니다.");
            }
        }

        private static void EnsureSuccess(HttpResponseMessage res)
        {
            if (res.IsSuccessStatusCode) return;
            if (res.StatusCode == HttpStatusCode.Unauthorized) throw new ApiKeyInvalidException();
            if (res.StatusCode == HttpStatusCode.ServiceUnavailable) throw new ApiMaintenanceException();
            if ((int)res.StatusCode == HTTP_TOO_MANY_REQUESTS) throw new ApiRateLimitException();
            throw new Exception($"경매장 API 요청 실패 (HTTP {(int)res.StatusCode} {res.ReasonPhrase})");
        }
    }
}﻿using LOSTARK_GEM_FINDER.Core;
using LOSTARK_GEM_FINDER.Models;

namespace LOSTARK_GEM_FINDER.Services
{
    public class GemDataRepository : IGemDataRepository
    {
        public GemData Data { get; private set; }
        public string LoadWarning { get; private set; }

        public GemDataRepository()
        {
            string path = AppConstants.DataFilePath;
            Data = JsonFileStore.Load<GemData>(path, out bool isCorrupted);

            if (isCorrupted)
            {
                string corruptPath = JsonFileStore.PreserveCorrupt(path);
                Data = JsonFileStore.Load<GemData>(JsonFileStore.GetBackupPath(path), out _);
                LoadWarning = Data != null
                    ? $"저장 파일이 손상되어 백업에서 복구했습니다.\n손상된 원본: {corruptPath}"
                    : $"저장 파일이 손상되어 새로 시작합니다.\n손상된 원본: {corruptPath}";
            }

            if (Data == null) Data = new GemData();
        }

        public void Save() => JsonFileStore.Save(AppConstants.DataFilePath, Data);
    }
}﻿using System;
using System.Collections.Generic;
using System.Globalization;
using System.Linq;
using System.Threading;
using System.Threading.Tasks;
using LOSTARK_GEM_FINDER.Core;
using LOSTARK_GEM_FINDER.Models;

namespace LOSTARK_GEM_FINDER.Services
{
    public class GemPriceService : IGemPriceService
    {
        private static readonly IReadOnlyDictionary<string, long> EmptyHistory = new Dictionary<string, long>();

        private readonly IAuctionAPI _api;
        private readonly IGemDataRepository _db;
        private readonly Dictionary<string, GemQuote> _quotes = new Dictionary<string, GemQuote>();

        public event Action OnPricesUpdated;

        public IReadOnlyDictionary<string, GemQuote> Quotes => _quotes;
        public IReadOnlyList<PriceAlarm> Alarms => _db.Data.Alarms;
        public DateTime? LastUpdated { get; private set; }

        public GemPriceService(IAuctionAPI api, IGemDataRepository db)
        {
            _api = api;
            _db = db;

            foreach (var type in AppConstants.GemTypes)
            {
                for (int level = AppConstants.MIN_GEM_LEVEL; level <= AppConstants.MAX_GEM_LEVEL; level++)
                    _quotes[GemKeys.Make(type.ShortName, level)] = new GemQuote { TypeName = type.ShortName, Level = level };
            }
        }

        public async Task<List<PriceAlarm>> RefreshAsync()
        {
            Dictionary<string, long?> newPrices;

            // 🌟 동시에 보내는 요청 수를 제한해서 호출 한도를 보호
            using (var limiter = new SemaphoreSlim(AppConstants.MAX_CONCURRENT_REQUESTS))
            {
                var tasks = new List<Task<KeyValuePair<string, long?>>>();
                foreach (var type in AppConstants.GemTypes)
                {
                    for (int level = AppConstants.MIN_GEM_LEVEL; level <= AppConstants.MAX_GEM_LEVEL; level++)
                        tasks.Add(FetchAsync(type, level, limiter));
                }

                // 하나라도 실패하면 여기서 예외 → 아래 반영 단계로 가지 않음 (부분 갱신 방지)
                var results = await Task.WhenAll(tasks);
                newPrices = results.ToDictionary(r => r.Key, r => r.Value);
            }

            ApplyPrices(newPrices);
            var newlyTriggered = EvaluateAlarms();
            LastUpdated = DateTime.Now;

            try
            {
                _db.Save();
            }
            finally
            {
                OnPricesUpdated?.Invoke();
            }
            return newlyTriggered;
        }

        private async Task<KeyValuePair<string, long?>> FetchAsync(GemType type, int level, SemaphoreSlim limiter)
        {
            await limiter.WaitAsync();
            try
            {
                long? price = await _api.GetLowestBuyPriceAsync(type.GetItemName(level), type.Tier);
                return new KeyValuePair<string, long?>(GemKeys.Make(type.ShortName, level), price);
            }
            finally
            {
                limiter.Release();
            }
        }

        private void ApplyPrices(Dictionary<string, long?> newPrices)
        {
            string today = DateTime.Now.ToString(AppConstants.HISTORY_DATE_FORMAT, CultureInfo.InvariantCulture);

            foreach (var kvp in newPrices)
            {
                var quote = _quotes[kvp.Key];

                // 첫 갱신이면 지난 실행 때 저장한 가격과 비교
                long? previous = quote.Price;
                if (!previous.HasValue && _db.Data.LastPrices.TryGetValue(kvp.Key, out long saved)) previous = saved;

                quote.PreviousPrice = previous;
                quote.Price = kvp.Value;

                if (!kvp.Value.HasValue) continue;
                long price = kvp.Value.Value;

                _db.Data.LastPrices[kvp.Key] = price;
                RecordDailyLowest(kvp.Key, today, price);
            }
        }

        // 하루에 여러 번 갱신해도 그날의 최저가 하나만 기록
        private void RecordDailyLowest(string gemKey, string day, long price)
        {
            if (!_db.Data.History.TryGetValue(gemKey, out SortedDictionary<string, long> days))
            {
                days = new SortedDictionary<string, long>(StringComparer.Ordinal);
                _db.Data.History[gemKey] = days;
            }

            if (!days.TryGetValue(day, out long recorded) || price < recorded) days[day] = price;
        }

        private List<PriceAlarm> EvaluateAlarms()
        {
            var newlyTriggered = new List<PriceAlarm>();
            foreach (var alarm in _db.Data.Alarms)
            {
                if (UpdateAlarmState(alarm)) newlyTriggered.Add(alarm);
            }
            return newlyTriggered;
        }

        // 🌟 목표가 이하로 "새로" 내려왔을 때만 true → 같은 알림이 5분마다 반복되지 않음
        //    가격이 목표가 위로 다시 오르면 해제돼서 다음 하락 때 또 알려줌
        private bool UpdateAlarmState(PriceAlarm alarm)
        {
            if (!_quotes.TryGetValue(alarm.GemKey, out GemQuote quote) || !quote.Price.HasValue) return false;

            bool isReached = quote.Price.Value <= alarm.TargetPrice;
            bool isNew = isReached && !alarm.IsTriggered;
            alarm.IsTriggered = isReached;
            return isNew;
        }

        // 같은 보석에 알림이 이미 있으면 목표가만 변경
        public PriceAlarm SetAlarm(GemSelection gem, long targetPrice)
        {
            var alarm = _db.Data.Alarms.FirstOrDefault(a => a.GemKey == gem.Key);
            if (alarm == null)
            {
                alarm = new PriceAlarm { TypeName = gem.TypeName, Level = gem.Level };
                _db.Data.Alarms.Add(alarm);
            }

            alarm.TargetPrice = targetPrice;
            alarm.IsTriggered = false;
            UpdateAlarmState(alarm);   // 이미 목표가 이하라면 표시만 하고 풍선 알림은 생략

            _db.Save();
            return alarm;
        }

        public void RemoveAlarm(PriceAlarm alarm)
        {
            if (_db.Data.Alarms.Remove(alarm)) _db.Save();
        }

        public IReadOnlyDictionary<string, long> GetHistory(string gemKey)
            => _db.Data.History.TryGetValue(gemKey, out SortedDictionary<string, long> days) ? (IReadOnlyDictionary<string, long>)days : EmptyHistory;
    }
